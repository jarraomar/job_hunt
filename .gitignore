# Personal data — never commit. Holds address, phone, work-authorization
# status, and salary expectations (spec section 14).
profile/
seed/

# Source documents at the repo root. These carry a home address and phone
# number; without these lines a plain `git add .` would commit them.
/Resume.pdf
/Personalized Cover Letter.docx

# Secrets. Configuration comes from the real environment (see
# docs/environment.md); nothing here reads a dotenv file.
.env
.env.*

# Vercel
.vercel/
# .python-version, .vercelignore, vercel.json and uv.lock ARE committed:
# they pin the runtime and dependency graph so a Vercel build matches local.

# Local Postgres cluster lives outside the repo now (see scripts/dev_db.sh).
# Kept here so an older checkout does not resurrect it.
.pgdata/

# Python
venv/
build/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.vercel
.env*